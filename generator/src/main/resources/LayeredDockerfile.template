# --- Gradlezilla Android Builder (Layered) ---
FROM eclipse-temurin:{{JDK_VERSION}}-jdk-jammy

# Install required OS packages
RUN apt-get update && apt-get install -y \
    wget unzip git git-lfs && \
    rm -rf /var/lib/apt/lists/*

# Set up Android SDK environment variables
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools

# Download and install Android Command Line Tools
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-{{CMDLINE_TOOLS_VERSION}}_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    rm cmdline-tools.zip && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest

# Accept licenses and install exact project SDK versions
RUN yes | sdkmanager --licenses > /dev/null && \
    sdkmanager {{SDK_PACKAGES}}

# --- Dependency Resolution Layer ---
# Copy only the files Gradle needs to configure the build and resolve
# dependencies. Docker caches this layer, so it's only invalidated when
# build configuration or dependency versions change, not on every source edit.
WORKDIR /workspace

COPY gradlew gradlew
COPY gradle gradle
COPY build.gradle* settings.gradle* gradle.properties* ./
{{ADDITIONAL_COPIES}}
RUN chmod +x ./gradlew

RUN ./gradlew --no-daemon {{DEPENDENCY_WARMUP_TASKS}} || true

# --- Build Execution Layer ---
# Copy the rest of the project source. Only this layer (and the final build)
# is invalidated when application code changes.
COPY . .

# Default build command (assemble release APKs)
CMD ["bash", "-c", "./gradlew assembleRelease --no-daemon"]
