# --- Gradlezilla Android build environment ---
#
# This image is the build ENVIRONMENT only: the JDK and Android SDK packages
# this project needs. It does not contain the project's source code — mount
# the repository into /workspace and run Gradle there.
#
#   docker build -t my-android-env .
#   docker run --rm -v "$PWD:/workspace" my-android-env ./gradlew assembleDebug
#
FROM eclipse-temurin:{{JDK_VERSION}}-jdk-jammy

# Install required OS packages
RUN apt-get update && apt-get install -y \
    wget unzip git git-lfs && \
    rm -rf /var/lib/apt/lists/*

# Set up Android SDK environment variables
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin

# Download and install Android Command Line Tools
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-{{CMDLINE_TOOLS_VERSION}}_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    rm cmdline-tools.zip && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest

# Accept licenses and install exact project SDK versions
RUN yes | sdkmanager --licenses > /dev/null && \
    sdkmanager {{SDK_PACKAGES}}

# Mount point for the project. Source is not copied into the image — run
# Gradle here against a bind-mounted repository.
WORKDIR /workspace
